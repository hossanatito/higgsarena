{
  "name": "higgsarena",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted studio for the Higgsfield API with team budgets, model controls and analytics.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:prepare": "tsx --conditions=react-server scripts/cli.ts boot",
    "vercel-build": "pnpm deploy:prepare && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "tsx scripts/setup.ts",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "tsx --conditions=react-server scripts/promote.ts",
    "keys:rotate": "tsx --conditions=react-server scripts/rotate-keys.ts",
    "catalog:pull": "tsx scripts/catalog-pull.ts",
    "build:cli": "esbuild scripts/cli.ts --bundle --platform=node --format=esm --target=node20 --conditions=react-server --outfile=dist/cli.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "mock:higgsfield": "tsx scripts/mock-higgsfield.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/lib-storage": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.28",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.40.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
