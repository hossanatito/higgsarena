# HiggsArena configuration.
# Run `pnpm setup` to copy this file to .env and replace every demo value
# with fresh random secrets. The production server refuses to start while a
# demo value below is still in use.

# --- Required -------------------------------------------------------------

# Postgres connection string. `pnpm db:up` starts one on 127.0.0.1:5432.
DATABASE_URL=postgres://higgsarena:higgsarena@127.0.0.1:5432/higgsarena

# Public URL of the app. Must be https:// in production. Used for links,
# OAuth callbacks and Higgsfield webhooks.
APP_URL=http://localhost:3000

# Session signing secret, 32+ random characters. DEMO VALUE, replaced by `pnpm setup`.
BETTER_AUTH_SECRET=demo-only-change-me-demo-only-change-me

# 32 random bytes, base64, used to encrypt stored secrets. DEMO VALUE, replaced by `pnpm setup`.
ENCRYPTION_KEY=ZGVtby1vbmx5LWNoYW5nZS1tZS1kZW1vLW9ubHktMDA=

# Comma-separated emails that become owners when they sign in.
# The first person to sign up never becomes owner automatically.
OWNER_EMAILS=you@example.com

# --- Optional -------------------------------------------------------------

# Previous ENCRYPTION_KEY during key rotation (see `pnpm keys:rotate`).
ENCRYPTION_KEY_PREVIOUS=

# Seed demo users and show a banner. Local testing only; blocked in production.
DEMO_MODE=false

# Bootstrap the organization's Higgsfield key on first run. You can also add
# it later in Admin → API keys. Create keys at https://console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# whsec_… webhook signing secret from Higgsfield Console → Settings.
HF_WEBHOOK_SECRET=

# Google sign-in. Callback URL: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in. Callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email fallback when nothing is configured in Admin → Settings → Email.
# Without any provider, development prints emails to the server console.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM="HiggsArena <studio@example.com>"

# Protects /api/cron/sweep. Required in production. DEMO VALUE, replaced by `pnpm setup`.
CRON_SECRET=demo-cron-secret-change-me

# Set to true when running behind a reverse proxy you control (Caddy in the
# Docker setup) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# --- Docker Compose (production profile) ----------------------------------

# Email for Let's Encrypt certificates (Caddy).
ACME_EMAIL=
# Domain Caddy serves, without https:// (e.g. studio.example.com).
DOMAIN=
# Password for the bundled Postgres container.
POSTGRES_PASSWORD=higgsarena
